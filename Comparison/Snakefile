SEED = config["seed"]
HOLDOUT = config["holdout"] 

MODULE_PREFIX = config.get("module_prefix", "")
def prefix_path(path):
    import os
    return os.path.join(MODULE_PREFIX, path) if MODULE_PREFIX else path

