FROM condaforge/mambaforge:latest

SHELL ["/bin/bash", "-lc"]

RUN mamba create -y -n maxatac -c conda-forge -c bioconda \
      python=3.9 \
      samtools \
      bedtools \
      htslib \
      ucsc-bedgraphtobigwig \
      pigz \
      wget \
      git \
      graphviz \
      py2bit \
      pybedtools \
      pybigwig \
      pysam \
  && mamba clean -afy

ENV PATH="/opt/conda/envs/maxatac/bin:${PATH}"
ENV GRAPHVIZ_DOT="/opt/conda/envs/maxatac/bin/dot"

# Install Python deps explicitly into the maxatac env
RUN /opt/conda/envs/maxatac/bin/pip install --no-cache-dir \
      "numpy==1.19.5" \
      "tensorflow==2.5.0" \
      "keras-preprocessing==1.1.2" \
      "biopython==1.79" \
      "pydot==1.4.2" \
      "matplotlib==3.4.3" \
      "scikit-learn==1.0" \
      "pandas==1.3.3" \
      "pyfiglet==0.8.post1" \
      "pyyaml==6.0" \
      "seaborn==0.11.2" \
      "maxatac==1.0.6"

RUN git clone https://github.com/MiraldiLab/maxATAC.git /opt/maxATAC

WORKDIR /opt/maxATAC

# Build-time checks: fail image build early if graphviz/pydot are not usable
RUN which dot && dot -V && \
    /opt/conda/envs/maxatac/bin/python -c "import pydot; print('pydot ok')"

CMD ["maxatac"]