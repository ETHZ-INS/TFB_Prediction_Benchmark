checkpoint common_create_encode_atac_placeholder_data:
  input:
    downloaded_atac_file_ids="data/common/01_encode_atac_ids.tsv",
  output:
    placeholder_atac_files_list="data/common/02_placeholder_encode_atac_files.tsv",
  params:
    raw_dir="data/common/01_raw_atac"
  benchmark: "benchmarks/preprocessing/create_encode_atac_placeholder_data.tsv"
  log: "logs/preprocessing/create_encode_atac_placeholder_data.log"
  threads: 1
  container: "tfbench-preproc.sif"
  shell: 
    """
      exec 2>>{log} 
      mkdir -p {params.raw_dir}
      cut -f1,4,5 "{input.downloaded_atac_file_ids}" | tail -n +2 | while IFS=$'\t' read -r accession href CellularContext; do
        if [[ "$href" != "NA" ]]; then 
          printf "%s\t%s\t%s\n" "$accession" "$CellularContext" "$href" > {params.raw_dir}/"$accession".tsv
          printf "%s\t%s\t%s\n" "$accession" "$CellularContext" "$href" >> {output.placeholder_atac_files_list}
        fi
      done
    """
    
def atac_placeholder_tsv(wc):
    checkpoints.common_create_encode_atac_placeholder_data.get()
    return f"data/common/01_raw_atac/{wc.accession}.tsv"
  
rule common_download_encode_atac_data:
  input:
    placeholder_file=atac_placeholder_tsv 
  output:
     bam_file="data/common/01_raw_atac/{accession}.bam",
     idxstats_file="data/common/01_raw_atac/{accession}.idxstats.txt"
  params:
    raw_dir="data/common/01_raw_atac"
  benchmark: "benchmarks/preprocessing/download_encode_atac_data_{accession}.tsv"
  log: "logs/preprocessing/download_encode_atac_data_{accession}.log"
  container: "tfbench-preproc.sif"
  threads: 1
  shell:
    """
      exec 2>>{log} 
      IFS=$'\t' read -r accession _ href _ < {input.placeholder_file}
      echo $accession
      wget -O {params.raw_dir}/$accession.bam "https://www.encodeproject.org/$href"
        
      # index
      samtools index -@ {threads} {output.bam_file}
      # subset to autosomes
      samtools view -b -o "data/common/01_raw_atac/filtered_{wildcards.accession}.bam" {output.bam_file} chr{{1..22}}
      
      # switch to original name
      mv "data/common/01_raw_atac/filtered_{wildcards.accession}.bam" {output.bam_file}
      
      # re-index
      samtools index -@ {threads} {output.bam_file}
      samtools idxstats -@ {threads} {output.bam_file} > {output.idxstats_file}
    """

get_rawBam_by_context = partial(get_accession_by_context, 
                                fileDir="data/common/01_raw_atac", 
                                fileType=".bam")
