ruleorder:
  common_process_nonencode_atac_h1 > common_download_encode_atac_data  
ruleorder:
  common_process_nonencode_atac_hela > common_download_encode_atac_data 
ruleorder:
  common_process_nonencode_atac_jurkat > common_download_encode_atac_data 
    
rule common_clean_atac_data: 
  input:
    bam_file="data/common/02_merged_atac/merged_{cellularContext}.bam"
  output:
    bam_file="data/common/03_merged_cleaned_atac/merged_{cellularContext}.bam",
    idxstats_file="data/common/03_merged_cleaned_atac/merged_{cellularContext}.idxstats.txt"
  params:
    out_dir="data/common/03_merged_cleaned_atac"
  benchmark: "benchmarks/preprocessing/clean_atac_data_{cellularContext}.tsv"
  log: "logs/preprocessing/clean_atac_data_{cellularContext}.log"
  container: "tfbench-preproc.sif"
  threads: 4
  shell:
    """
      exec 2>>{log} 
      mkdir -p {params.out_dir}
      samtools sort -o {output.bam_file} {input.bam_file}
      samtools index -@ {threads} {output.bam_file}
      samtools idxstats -@ {threads} {output.bam_file} > {output.idxstats_file}
    """
    
rule common_call_peaks_atac:
  input:
    bam_file="data/common/03_merged_cleaned_atac/merged_{cellularContext}.bam"
  output:
    peak_file="data/common/03_peaks_atac/merged_{cellularContext}_peaks.narrowPeak"
  params:
    peaks_dir="data/common/03_peaks_atac",
    seed=SEED
  benchmark: "benchmarks/preprocessing/call_peaks_atac_{cellularContext}.tsv"
  log: "logs/preprocessing/call_peaks_atac_{cellularContext}.log"
  threads: 4
  container: "tfbench-preproc.sif"
  shell: 
    """
      exec 2>>{log} 
      mkdir -p {params.peaks_dir}
      macs3 callpeak --outdir {params.peaks_dir} \
      -f BAM \
      -t {input.bam_file} \
      -n merged_{wildcards.cellularContext} \
      --seed {params.seed} \
      --nomodel
    """

rule common_remove_blacklisted_atac_peaks:
  input:
    peaks=rules.common_call_peaks_atac.output.peak_file
  output:
    filtered_peaks="data/common/03_peaks_atac/filtered_merged_{cellularContext}_peaks.narrowPeak",
  params:
    blacklistPath="data/annotation/blacklist.bed"
  threads: 4
  benchmark: "benchmarks/preprocessing/remove_blacklisted_atac_peaks_{cellularContext}.tsv"
  log: "logs/preprocessing/remove_blacklisted_atac_peaks_{cellularContext}.log"
  container: "tfbench-preproc.sif"
  shell:
    """
      exec 2>>{log} 
      bedtools intersect -v \
      -a {input.peaks} \
      -b {params.blacklistPath} > {output.filtered_peaks}
    """

checkpoint common_get_combinations:
  input:
    downloaded_chip_peak_ids="data/common/01_encode_chip_peak_ids.tsv",
    downloaded_chip_coverage_ids="data/common/01_encode_chip_coverage_ids.tsv",
    downloaded_atac_ids="data/common/01_encode_atac_ids.tsv",
    atac_peaks=lambda wildcards: expand("data/common/03_peaks_atac/filtered_merged_{cellularContext}_peaks.narrowPeak", 
                                        cellularContext=get_cellularContexts_all(wildcards)),
    chip_peaks=lambda wildcards: expand("data/common/02_merged_chip_peaks/filtered_merged_peaks_{comb}.bed", 
                                        comb=get_combs(wildcards)),
    chip_peaks_signal=lambda wildcards: expand("data/common/02_merged_chip_peaks/filtered_merged_peaks_signal_{comb}.bed", 
                                               comb=get_combs(wildcards)),
    chip_noncons_peaks=lambda wildcards: expand("data/common/02_merged_chip_peaks/filtered_nonCons_peaks_{comb}.bed", 
                                                comb=get_combs(wildcards)),
    chip_coverage_tracks=lambda wildcards: expand("data/common/01_raw_chip_coverage/{acc}.bam", 
                                                  acc=get_accession_chip_coverage(wildcards)),
  params:
    holdout=HOLDOUT,
  output:
    combinations="data/common/04_train_test_combinations.tsv",
    all_raw_atac="data/common/04_all_raw_atac.tsv"
  benchmark: "benchmarks/preprocessing/get_combinations.tsv"
  log: "logs/preprocessing/get_combinations.log"
  threads: 1
  container: "Training_Prediction/tfbench-preproc.sif"
  script: "src/preprocessing/get_combinations.R"

if "maxATAC" in METHODS:
