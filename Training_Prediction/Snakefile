rule common_download_encode_chip_peaks:
  input:
    downloaded_chip_peak_ids="data/common/01_encode_chip_peak_ids.tsv"
  output:
    downloaded_chip_peaks="data/common/02_downloaded_raw_chip_peaks.tsv",
  params:
    raw_dir="data/common/01_raw_chip_peaks",
  benchmark: "benchmarks/preprocessing/download_encode_chip_peaks.tsv"
  log: "logs/preprocessing/download_encode_chip_peaks.log"
  container: "tfbench-preproc.sif"
  threads: 1
  shell:
    """
      exec 2>>{log} 
      mkdir -p {params.raw_dir}
      cut -f1,4 "{input.downloaded_chip_peak_ids}" | tail -n +2 | while IFS=$'\t' read -r accession href; do
        echo "processing: $href"
        echo $href >> {output.downloaded_chip_peaks}
        wget -O {params.raw_dir}/$accession.bed.gz "https://www.encodeproject.org/$href"
      done
    """
    
checkpoint common_create_encode_chip_coverage_placeholder_data:
  input:
    downloaded_chip_coverage_ids="data/common/01_encode_chip_coverage_ids.tsv",
  output:
    placeholder_chip_files_list="data/common/02_placeholder_encode_chip_coverage_files.tsv",
  params: 
    raw_dir="data/common/01_raw_chip_coverage",
  benchmark: "benchmarks/preprocessing/chip_coverage_placeholder_data.tsv"
  log: "logs/preprocessing/chip_coverage_placeholder_data.log"
  container: "tfbench-preproc.sif"
  threads: 1
  shell:
    """
    exec 2>>{log} 
    mkdir -p {params.raw_dir}
    cut -f1,2,4 "{input.downloaded_chip_coverage_ids}" | tail -n +2 | while IFS=$'\t' read -r Accession href CellularContext; do
      if [[ "$href" != "NA" ]]; then 
        printf "%s\t%s\t%s\n" "$Accession" "$CellularContext" "$href" > {params.raw_dir}/"$Accession".tsv
        printf "%s\t%s\t%s\n" "$Accession" "$CellularContext" "$href" >> {output.placeholder_chip_files_list}
      fi
    done
    """
    
rule common_download_encode_chip_coverage:
  input:
     placeholder_list="data/common/02_placeholder_encode_chip_coverage_files.tsv",
     placeholder_file="data/common/01_raw_chip_coverage/{accession}.tsv"
  output: 
    bam_file="data/common/01_raw_chip_coverage/{accession}.bam",
    idxstats_file="data/common/01_raw_chip_coverage/{accession}.idxstats.txt"
  params: 
    raw_dir=rules.common_create_encode_chip_coverage_placeholder_data.params.raw_dir,
  benchmark: "benchmarks/preprocessing/download_encode_chip_coverage_{accession}.tsv"
  log: "logs/preprocessing/download_encode_chip_coverage_{accession}.log"
  container: "tfbench-preproc.sif"
  threads: 1
  shell:
    """
      exec 2>>{log} 
      IFS=$'\t' read -r accession _ href _ < {input.placeholder_file}
      wget -O {params.raw_dir}/$accession.bam "https://www.encodeproject.org/$href"
      
      # index
      samtools index -@ {threads} {output.bam_file}
      # subset to autosomes
      samtools view -b -o "data/common/01_raw_chip_coverage/filtered_{wildcards.accession}.bam" {output.bam_file} chr{{1..22}}
      
      # switch to original name
      mv "data/common/01_raw_chip_coverage/filtered_{wildcards.accession}.bam" {output.bam_file}

      # re-index
      samtools index -@ {threads} {output.bam_file}
      samtools idxstats -@ {threads} {output.bam_file} > {output.idxstats_file}
    """
    
checkpoint common_merge_chip_peaks:
