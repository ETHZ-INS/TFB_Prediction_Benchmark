MODULE_PREFIX = config.get("module_prefix", "")
def prefix_path(path):
    import os
    return os.path.join(MODULE_PREFIX, path) if MODULE_PREFIX else path

VAL_CHRS = ["chr2", "chr4", "chr9"]
AUT_CHRS = [f"chr{i}" for i in range(1, 23)]

wildcard_constraints:
    cellularContextEncode="(K562|HepG2|GM12878|MCF-7)"

# OSF: Preregistered datasets
TRAIN_DAT_URL = "https://osf.io/download/gfq6n"
TEST_DAT_URL = "https://osf.io/download/vxmq3"

PREREGISTERED_DATASETS = {
    "trainData": TRAIN_DAT_URL,
    "testData": TEST_DAT_URL
}

def get_accession_atac(wildcards):
    checkpoint_output1 = checkpoints.common_create_encode_atac_placeholder_data.get().output[0]
    checkpoint_output2 = checkpoints.common_get_encode_atac_ids.get().output[0]
    
    df = pd.read_csv(checkpoint_output2, sep="\t", 
                     header=0,
                     names=["accession", "output_type",
                            "file_type",	"href",	
                            "CellularContext",	"Exp_Accession",	
                            "set"])
    df = df[df["accession"].notna()]
    accession = df["accession"].unique().tolist()

    return accession
  
def get_accession_chip_peaks(wildcards):
    checkpoint_output = checkpoints.common_get_encode_chip_peak_ids.get().output[0]

    df = pd.read_csv(checkpoint_output, sep="\t", 
                     header=0,
                     names=["accession", "output_type",
                            "file_type",	"href",	"peak_type", "TF",
                            "CellularContext",	"Exp_Accession",	
                            "set"])
    df = df[df["accession"].notna()]
    accession = df["accession"].unique().tolist()
    
    return accession
  
def get_accession_chip_coverage(wildcards):
    checkpoint_output1 = checkpoints.common_create_encode_chip_coverage_placeholder_data.get().output[0]
    checkpoint_output2 = checkpoints.common_get_encode_chip_coverage_ids.get().output[0]
    
    df = pd.read_csv(checkpoint_output2, sep="\t", 
                     header=0,
                     names=["Accession", "href", "TF", "CellularContext",
                            "Exp_Accession",	"set",	
                            "output_type",	"file_type"])
    df = df[df["Accession"].notna()]
    accession = df["Accession"].unique().tolist()
    
    return accession
  
def get_combs(wildcards):
    checkpoint_output1 = checkpoints.common_merge_chip_peaks.get().output[0]
    checkpoint_output = checkpoints.common_get_encode_chip_peak_ids.get().output[0]
    df = pd.read_csv(checkpoint_output, sep="\t", 
                     header=0,
                     names=["accession", "output_type",
                            "file_type",	"href",	"peak_type", "TF",
                            "CellularContext",	"Exp_Accession",	
                            "set"])
                            
    df["comb"] = df["TF"].astype("string").fillna("NA") + "_" + df["CellularContext"].astype("string").fillna("NA")
    combs = df["comb"].unique()
    
    return combs
    

def get_accession_by_context(wildcards, fileDir, fileType, prefix=""):
    #checkpoint_output1 = checkpoints.common_prepare_merge_encode_atac_bams.get().output[0]
    checkpoint_output2 = checkpoints.common_get_encode_atac_ids.get().output[0]
    df = pd.read_csv(checkpoint_output2, sep="\t", 
                     header=0,
                     names=["accession", "output_type",
                            "file_type",	"href",	
                            "CellularContext",	"Exp_Accession",	
                            "set"])
    df = df[df["accession"].notna()]
    samples = df[df["CellularContext"] == wildcards.cellularContextEncode]["accession"].tolist()

    files = [f"{fileDir}/{prefix}{sample}{fileType}" for sample in samples] 
    return files
  
def get_cellularContexts(wildcards, which="all"):
    #checkpoint_output1 = checkpoints.common_prepare_merge_encode_atac_bams.get().output[0]
    checkpoint_output2 = checkpoints.common_get_encode_atac_ids.get().output[0]
    df = pd.read_csv(checkpoint_output2, sep="\t")

    if which=="encode":
      df = df.dropna()
    elif which=="nonEncode":
      df = df[df['accession'].isna()]
      
    contexts = df["CellularContext"].unique().tolist()  
      
    return contexts
  
get_cellularContexts_all = partial(get_cellularContexts, which="all")
get_cellularContexts_encode = partial(get_cellularContexts, which="encode")
get_cellularContexts_nonencode = partial(get_cellularContexts, which="nonEncode")
  
ALL_TARGET_BUILDERS = [] 
def final_targets(_):
    ckpt1 = checkpoints.common_get_combinations.get()
    combs = get_combs(None)
    coverage_accessions = get_accession_chip_coverage(None)
    contexts = get_cellularContexts_all(None)
    
    chip_coverage_files= [f"data/common/01_raw_chip_coverage/{acc}.bam" for acc in coverage_accessions]
    chip_peaks= [f"data/common/02_merged_chip_peaks/filtered_merged_peaks_{comb}.bed" for comb in combs]
    chip_peaks_signal=[f"data/common/02_merged_chip_peaks/filtered_merged_peaks_signal_{comb}.bed" for comb in combs]
    chip_noncons_peaks=[f"data/common/02_merged_chip_peaks/filtered_nonCons_peaks_{comb}.bed" for comb in combs]
    atac_peaks=[f"data/common/03_peaks_atac/filtered_merged_{context}_peaks.narrowPeak" for context in contexts]
    
    targets = [
        "output/preprocessing/01_merging_replicate_peaks.html",
        #"output/FIMO/01_motif_matches_DHS.html",
        #"output/FIMO/01_motif_matches_all.html",
        ckpt1.output.combinations,
    ]
    targets =  targets+chip_coverage_files+chip_peaks+chip_peaks_signal+chip_noncons_peaks+atac_peaks

    for builder in ALL_TARGET_BUILDERS:
        targets.extend(builder(ckpt1))
    return targets
  
