rule Common_get_matches_genome:
  input:
    combs="data/common/04_train_test_combinations.tsv", # redundant
  output:
    html="output/FIMO/01_motif_matches_all.html",
  params:
    script=prefix_path("src/FIMO/01_motif_matches.Rmd"),
    motif_models=prefix_path("data/annotation/motif_models.rds"),
    refPath=prefix_path("data/annotation/Homo_sapiens.GRCh38.dna.primary_assembly.fa"),
    dhsPath="",
    tfsSub=TFSUB,
    fimo_out_dir=prefix_path("output/FIMO"),
    out_dir=prefix_path("data/motifs/motif_matches_genome"),
    thresh=0.0001,
  container: "tfbench-preproc.sif"
  benchmark: "benchmarks/preprocessing/get_matches_genome.tsv"
  log: "logs/preprocessing/get_matches_genome.log"
  threads: 4,
  shell:
    """
        exec 2>>{log} 
        mkdir -p "{params.fimo_out_dir}"
        mkdir -p {params.out_dir}
        export MEME_PATH="$(which fimo)"
        Rscript -e 'rmarkdown::render("{params.script}", 
                                      "html_document", 
                                       output_file="../../{output.html}",
                                       params=list(motif_models="{params.motif_models}",
                                                   tfs="{params.tfsSub}",
                                                   combs_dir="{input.combs}",
                                                   refPath="{params.refPath}",
                                                   dhsPath="{params.dhsPath}",
                                                   outDir="{params.out_dir}",
                                                   thresh="{params.thresh}"))'
    """
    
