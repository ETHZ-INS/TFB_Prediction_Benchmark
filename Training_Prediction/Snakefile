                                                 downloaded_peaks_list_path="{input.downloaded_chip_peaks}",
                                                 out_dir_merged_peaks="{params.merged_dir}"))'
    """

rule common_remove_blacklisted_merged_chip_peaks:
  input:
    merging_report="output/preprocessing/01_merging_replicate_peaks.html",
    peaks="data/common/02_merged_chip_peaks/merged_peaks_{comb}.bed"
  output:
    filtered_peaks="data/common/02_merged_chip_peaks/filtered_merged_peaks_{comb}.bed"
  benchmark: "benchmarks/preprocessing/remove_blacklisted_merged_chip_peak_{comb}.tsv"
  log: "logs/preprocessing/remove_blacklisted_merged_chip_peak_{comb}.log"
  container: "tfbench-preproc.sif"
  threads: 1
  params:
    peak_dir="Training_Prediction/data/common/02_merged_chip_peaks",
    blacklist_path="Training_Prediction/data/annotation/blacklist.bed",
  shell:
    """
      exec 2>>{log} 
      bedtools intersect -v -a {params.peak_dir}/merged_peaks_{wildcards.comb}.bed \
      -b {params.blacklist_path} > {params.peak_dir}/filtered_merged_peaks_{wildcards.comb}.bed
    """

