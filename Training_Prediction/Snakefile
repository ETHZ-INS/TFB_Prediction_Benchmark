def all_prediction_files(wildcards):
    ckpt = checkpoints.common_get_combinations.get()
    files = []
    for builder in ALL_TARGET_BUILDERS:
        files.extend(builder(ckpt))
    # preserve order while removing duplicates
    return list(dict.fromkeys(files))

rule common_export_prediction_paths:
  input:
    combinations=lambda wildcards: checkpoints.common_get_combinations.get().output.combinations,
    predictions=all_prediction_files
  output:
    listfile="all_prediction_list.txt"
  run:
    print(os.getcwd())
    print(f"Exporting prediction file path to {output}...")
    pred_paths = [op.abspath(str(pred)) for pred in input.predictions]
    with open(output.listfile, "w") as f:
      if pred_paths:
        f.write("\n".join(pred_paths) + "\n")

