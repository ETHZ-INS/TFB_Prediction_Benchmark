FROM condaforge/mambaforge:latest

RUN conda create -y -n maxatac -c conda-forge -c bioconda \
      python=3.9 \
      samtools \
      bedtools \
      htslib \
      ucsc-bedgraphtobigwig \
      pigz \
      wget \
      git \
      graphviz \
      py2bit \
      pybedtools \
      pybigwig \
      pysam \
  && conda clean -afy

ENV PATH="/opt/conda/envs/maxatac/bin:${PATH}"

RUN pip install --no-cache-dir \
      "numpy==1.19.5" \
      "tensorflow==2.5.0" \
      "keras-preprocessing==1.1.2" \
      "biopython==1.79" \
      "pydot==1.4.2" \
      "matplotlib==3.4.3" \
      "scikit-learn==1.0" \
      "pandas==1.3.3" \
      "pyfiglet==0.8.post1" \
      "pyyaml==6.0" \
      "seaborn==0.11.2" \
      "maxatac==1.0.6"

RUN git clone https://github.com/MiraldiLab/maxATAC.git /opt/maxATAC

WORKDIR /opt/maxATAC

CMD ["maxatac"]